flowchart LR
  subgraph Frontend[React SPA]
    SYS[Select source and target]
    UP[Upload files and review inventory]
    PLAN[Review migration plan]
    CONVERT[Convert or re-convert selected objects<br/>explicit consent before code is sent]
    SETTINGS["Settings UI<br/>Devin PAT, organization ID, API base URL,<br/>confidence threshold, max concurrency,<br/>ACU cap per run — enforcement planned"]
    KBUI[Knowledge-base settings<br/>status, refresh, cancel, rollback]
  end
  subgraph Backend[FastAPI application]
    SESSION[POST /api/session/confirm]
    UPAPI[POST /api/uploads<br/>GET /api/discovery/status]
    INV[GET /api/inventory<br/>GET /api/graph]
    PLANAPI[POST /api/plan<br/>GET /api/plan]
    CONVAPI["POST /api/convert/estimate<br/>POST /api/convert<br/>GET /api/convert/jobs/{job_id}<br/>GET /api/convert/jobs/{job_id}/events<br/>POST /api/convert/jobs/{job_id}/cancel"]
    SETTINGSAPI[GET/PUT /api/settings]
    KBAPI[GET /api/kb/status<br/>POST /api/kb/refresh<br/>DELETE /api/kb/refresh<br/>POST /api/kb/rollback]
    PACK[GET /api/download<br/>GET /api/report.md and /api/report.pdf]
    REG[Platform registry]
    DISC[DiscoveryRunner and parsers]
    PLANJOB[PlanJob or local draft]
    JOB[ConversionJob and LangGraph batch workflow]
    KBSTORE[KBStore, search, and refresh]
    VALID[Validation checks]
    REPORT[Package snapshot, ZIP, report builders]
    SECURITY[AuthState, SecretProtector,<br/>EncryptedFileStore, AuditLog]
  end
  SYS --> SESSION
  UP --> UPAPI --> DISC --> INV
  PLAN --> PLANAPI --> PLANJOB
  CONVERT --> CONVAPI --> JOB
  SETTINGS --> SETTINGSAPI
  KBUI --> KBAPI --> KBSTORE
  SESSION --> REG
  UPAPI --> SECURITY
  JOB --> KBSTORE
  JOB --> VALID
  CONVAPI --> PACK --> REPORT
