#!/usr/bin/env bash
# Generated by MigraAI - execution runner for @@DISPLAY@@.
# MigraAI never connects to your warehouse; this script only invokes
# '@@CLI@@', which reads connection details from its own profile,
# config file or environment variables.
#
# Command: @@COMMAND@@
#
@@DOC_LINES@@

set -u -o pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CONVERTED_DIR="$SCRIPT_DIR/../../converted"
CLI='@@CLI@@'

usage() {
    cat >&2 <<'USAGE'
Usage: run.sh [--execute] [--include-review] [-- <cli args>]

Default is a dry run that prints the ordered plan. --execute applies
the plan through the target CLI. --include-review also runs files
flagged for expert review. Everything after -- is passed to the CLI
verbatim (use it for a connection or profile name, never passwords).
USAGE
}

EXECUTE=0
INCLUDE_REVIEW=0
EXTRA=()
while [ $# -gt 0 ]; do
    case "$1" in
        --execute) EXECUTE=1 ;;
        --include-review) INCLUDE_REVIEW=1 ;;
        -h|--help) usage; exit 0 ;;
        --) shift; EXTRA+=("$@"); break ;;
        *) echo "Unknown argument: $1" >&2; usage; exit 2 ;;
    esac
    shift
done

PLAN_PATHS=(
@@PLAN_PATHS@@
)
PLAN_REVIEW=(
@@PLAN_REVIEW@@
)

PLAN_COUNT=${#PLAN_PATHS[@]}
SELECTED=0
i=0
while [ "$i" -lt "$PLAN_COUNT" ]; do
    n=$(printf '%03d' $((i + 1)))
    p=${PLAN_PATHS[$i]}
    if [ "${PLAN_REVIEW[$i]}" = "1" ]; then
        if [ "$INCLUDE_REVIEW" -eq 1 ]; then
            printf '[%s] RUN    %s  (expert review)\n' "$n" "$p"
            SELECTED=$((SELECTED + 1))
        else
            printf '[%s] SKIP   %s  (expert review; use --include-review)\n' "$n" "$p"
        fi
    else
        printf '[%s] RUN    %s\n' "$n" "$p"
        SELECTED=$((SELECTED + 1))
    fi
    i=$((i + 1))
done
if [ "$PLAN_COUNT" -eq 0 ]; then
    echo "(no SQL files to run)"
fi
printf 'Command: %s\n' '@@COMMAND@@'
if [ "${#EXTRA[@]}" -gt 0 ]; then
    printf '(+%s extra CLI args)\n' "${#EXTRA[@]}"
fi

MASKED_COUNT=0
i=0
while [ "$i" -lt "$PLAN_COUNT" ]; do
    f="$CONVERTED_DIR/${PLAN_PATHS[$i]}"
    if [ -f "$f" ] && grep -qF -- '***MASKED***' "$f"; then
        if [ "$EXECUTE" -eq 1 ]; then
            echo "replace the masked secret with a secret reference first: ${PLAN_PATHS[$i]}" >&2
        else
            echo "WARNING: masked secret placeholder found: ${PLAN_PATHS[$i]}"
        fi
        MASKED_COUNT=$((MASKED_COUNT + 1))
    fi
    i=$((i + 1))
done
if [ "$MASKED_COUNT" -gt 0 ] && [ "$EXECUTE" -eq 1 ]; then
    exit 3
fi

if [ "$EXECUTE" -ne 1 ]; then
    echo "Dry run only: nothing was executed. Re-run with --execute to apply."
    exit 0
fi

if ! command -v "$CLI" >/dev/null 2>&1; then
    echo "Required CLI '$CLI' not found on PATH. See README.md for install instructions." >&2
    exit 127
fi

i=0
while [ "$i" -lt "$PLAN_COUNT" ]; do
    if [ "${PLAN_REVIEW[$i]}" = "0" ] || [ "$INCLUDE_REVIEW" -eq 1 ]; then
        f="$CONVERTED_DIR/${PLAN_PATHS[$i]}"
        if [ ! -f "$f" ]; then
            echo "Missing converted file: ${PLAN_PATHS[$i]} (expected at $f)" >&2
            exit 1
        fi
    fi
    i=$((i + 1))
done

i=0
while [ "$i" -lt "$PLAN_COUNT" ]; do
    if [ "${PLAN_REVIEW[$i]}" = "0" ] || [ "$INCLUDE_REVIEW" -eq 1 ]; then
        p=${PLAN_PATHS[$i]}
        f="$CONVERTED_DIR/$p"
        n=$(printf '%03d' $((i + 1)))
        printf 'Applying [%s] %s\n' "$n" "$p"
        @@INVOKE@@
        rc=$?
        if [ "$rc" -ne 0 ]; then
            printf 'FAILED: %s (exit %s)\n' "$p" "$rc" >&2
            exit "$rc"
        fi
    fi
    i=$((i + 1))
done
printf 'All %s files applied.\n' "$SELECTED"
exit 0
