# Generated by MigraAI - execution runner for @@DISPLAY@@.
# MigraAI never connects to your warehouse; this script only invokes
# '@@CLI@@', which reads connection details from its own profile,
# config file or environment variables.
#
# Command: @@COMMAND@@
#
@@DOC_LINES@@
[CmdletBinding()]
param(
    [switch]$Execute,
    [switch]$IncludeReview,
    [string[]]$CliArgs = @()
)
Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'

$here = $PSScriptRoot
if (-not $here) {
    $here = Split-Path -Parent $MyInvocation.MyCommand.Path
}
$sep = [System.IO.Path]::DirectorySeparatorChar
$convertedDir = Join-Path (Split-Path -Parent (Split-Path -Parent $here)) 'converted'
$cli = '@@CLI@@'

$plan = @(
@@PS_PLAN@@
)

$selected = 0
for ($i = 0; $i -lt $plan.Count; $i++) {
    $n = '{0:d3}' -f ($i + 1)
    $p = $plan[$i].Path
    if ($plan[$i].Review) {
        if ($IncludeReview) {
            Write-Output ('[{0}] RUN    {1}  (expert review)' -f $n, $p)
            $selected++
        } else {
            Write-Output ('[{0}] SKIP   {1}  (expert review; use -IncludeReview)' -f $n, $p)
        }
    } else {
        Write-Output ('[{0}] RUN    {1}' -f $n, $p)
        $selected++
    }
}
if ($plan.Count -eq 0) {
    Write-Output '(no SQL files to run)'
}
Write-Output 'Command: @@COMMAND@@'
if ($CliArgs.Count -gt 0) {
    Write-Output ('(+{0} extra CLI args)' -f $CliArgs.Count)
}

$maskedCount = 0
for ($i = 0; $i -lt $plan.Count; $i++) {
    $f = Join-Path $convertedDir ($plan[$i].Path -replace '/', $sep)
    if ((Test-Path -LiteralPath $f) -and
        (Select-String -LiteralPath $f -SimpleMatch -Pattern '***MASKED***' -Quiet)) {
        if ($Execute) {
            [Console]::Error.WriteLine(
                "replace the masked secret with a secret reference first: $($plan[$i].Path)")
        } else {
            Write-Output "WARNING: masked secret placeholder found: $($plan[$i].Path)"
        }
        $maskedCount++
    }
}
if ($maskedCount -gt 0 -and $Execute) {
    exit 3
}

if (-not $Execute) {
    Write-Output 'Dry run only: nothing was executed. Re-run with -Execute to apply.'
    exit 0
}

if (-not (Get-Command $cli -ErrorAction SilentlyContinue)) {
    [Console]::Error.WriteLine(
        "Required CLI '$cli' not found on PATH. See README.md for install instructions.")
    exit 127
}

for ($i = 0; $i -lt $plan.Count; $i++) {
    if ((-not $plan[$i].Review) -or $IncludeReview) {
        $f = Join-Path $convertedDir ($plan[$i].Path -replace '/', $sep)
        if (-not (Test-Path -LiteralPath $f)) {
            [Console]::Error.WriteLine(
                "Missing converted file: $($plan[$i].Path) (expected at $f)")
            exit 1
        }
    }
}

for ($i = 0; $i -lt $plan.Count; $i++) {
    if ((-not $plan[$i].Review) -or $IncludeReview) {
        $p = $plan[$i].Path
        $f = Join-Path $convertedDir ($p -replace '/', $sep)
        $n = '{0:d3}' -f ($i + 1)
        Write-Output ('Applying [{0}] {1}' -f $n, $p)
        @@PS_INVOKE@@
        $rc = 1
        if (Test-Path -Path variable:LASTEXITCODE) {
            $rc = $LASTEXITCODE
        }
        if ($rc -ne 0) {
            [Console]::Error.WriteLine("FAILED: $p (exit $rc)")
            exit $rc
        }
    }
}
Write-Output ('All {0} files applied.' -f $selected)
exit 0
