<?xml version="1.0" encoding="UTF-8"?>
<POWERMART>
  <REPOSITORY NAME="ODS_REPO">
    <FOLDER NAME="RETAIL_ORDERS" OWNER="etlteam" SHARED="NOTSHARED">
      <SOURCE DATABASETYPE="Oracle" DBDNAME="ods" NAME="ODS_ORDERS" OWNERNAME="ODS"/>
      <SOURCE DATABASETYPE="Oracle" DBDNAME="ods" NAME="ODS_ORDER_ITEMS" OWNERNAME="ODS"/>
      <SOURCE DATABASETYPE="Oracle" DBDNAME="ods" NAME="ODS_PAYMENTS" OWNERNAME="ODS"/>
      <TARGET NAME="MART_ORDER_FACT"/>
      <TARGET NAME="MART_PAYMENT_SUMMARY"/>
      <MAPPING NAME="m_order_extract">
        <INSTANCE NAME="src_ord" TYPE="SOURCE" TRANSFORMATION_NAME="ODS_ORDERS"/>
        <INSTANCE NAME="src_itm" TYPE="SOURCE" TRANSFORMATION_NAME="ODS_ORDER_ITEMS"/>
        <TRANSFORMATION NAME="exp_amounts" TRANSFORMATION_TYPE="Expression">
          <TRANSFORMFIELD NAME="net_amt" EXPRESSION="GROSS_AMT - DISCOUNT_AMT"/>
          <TRANSFORMFIELD NAME="tax" EXPRESSION="GROSS_AMT * $$TaxRate"/>
        </TRANSFORMATION>
        <INSTANCE NAME="tgt_fact" TYPE="TARGET" TRANSFORMATION_NAME="MART_ORDER_FACT"/>
        <CONNECTOR FROMINSTANCE="src_ord" FROMFIELD="ORDER_ID" TOINSTANCE="exp_amounts" TOFIELD="ORDER_ID"/>
      </MAPPING>
      <MAPPING NAME="m_payment_aggregate">
        <INSTANCE NAME="src_pay" TYPE="SOURCE" TRANSFORMATION_NAME="ODS_PAYMENTS"/>
        <TRANSFORMATION NAME="agg_pay" TRANSFORMATION_TYPE="Aggregator">
          <TRANSFORMFIELD NAME="total" EXPRESSION="SUM(AMOUNT)"/>
        </TRANSFORMATION>
        <INSTANCE NAME="tgt_pay" TYPE="TARGET" TRANSFORMATION_NAME="MART_PAYMENT_SUMMARY"/>
      </MAPPING>
      <MAPPING NAME="m_order_enrich">
        <INSTANCE NAME="sc_cust" TYPE="SOURCE" TRANSFORMATION_NAME="sc_customer"/>
        <TRANSFORMATION NAME="lkp_status" TRANSFORMATION_TYPE="Lookup Procedure">
          <TABLEATTRIBUTE NAME="Lookup table name" VALUE="ref.ORDER_STATUS"/>
        </TRANSFORMATION>
        <TRANSFORMATION NAME="upd_router" TRANSFORMATION_TYPE="Update Strategy">
          <TRANSFORMFIELD NAME="op" EXPRESSION="IIF(STATUS='N','DD_INSERT','DD_UPDATE')"/>
        </TRANSFORMATION>
        <TRANSFORMATION NAME="rt_type" TRANSFORMATION_TYPE="Router"/>
        <INSTANCE NAME="tgt_fact2" TYPE="TARGET" TRANSFORMATION_NAME="MART_ORDER_FACT"/>
      </MAPPING>
      <SESSION NAME="s_order_extract" MAPPINGNAME="m_order_extract">
        <ATTRIBUTE NAME="Post-session success command" VALUE="sqlplus etl/x @scripts/audit.sql"/>
      </SESSION>
      <SESSION NAME="s_payment_agg" MAPPINGNAME="m_payment_aggregate">
        <SESSTRANSFORMATIONINST TRANSFORMATION_NAME="agg_pay">
          <ATTRIBUTE NAME="Pre SQL" VALUE="ALTER SESSION SET NLS_DATE_FORMAT='YYYY-MM-DD'"/>
        </SESSTRANSFORMATIONINST>
      </SESSION>
      <SESSION NAME="s_order_enrich" MAPPINGNAME="m_order_enrich"/>
      <SHORTCUT NAME="sc_customer" FOLDERNAME="RETAIL_CUSTOMER" REFOBJECTNAME="MART_CUSTOMER" REFOBJTYPE="Target Definition"/>
      <SHORTCUT NAME="sc_status" FOLDERNAME="RETAIL_ORDERS" REFOBJECTNAME="MART_ORDER_FACT" REFOBJTYPE="Target Definition"/>
      <CONFIG NAME="cfg_orders"/>
      <WIDGET NAME="legacy_component"/>
    </FOLDER>
  </REPOSITORY>
</POWERMART>
