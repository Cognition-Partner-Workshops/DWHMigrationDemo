<?xml version="1.0" encoding="UTF-8"?>
<POWERMART CREATION_DATE="03/14/2024" REPOSITORY_VERSION="188.97">
  <REPOSITORY NAME="ODS_REPO">
    <FOLDER NAME="RETAIL_CUSTOMER" OWNER="etlteam" SHARED="NOTSHARED">
      <SOURCE BUSINESSNAME="" DATABASETYPE="Oracle" DBDNAME="ods" NAME="ODS_CUSTOMERS" OWNERNAME="ODS">
        <SOURCEFIELD DATATYPE="number" FIELDNUMBER="1" NAME="CUST_ID" NULLABLE="NOTNULL"/>
        <SOURCEFIELD DATATYPE="varchar2" FIELDNUMBER="2" NAME="FULL_NAME"/>
        <SOURCEFIELD DATATYPE="varchar2" FIELDNUMBER="3" NAME="SEGMENT_CODE"/>
      </SOURCE>
      <SOURCE DATABASETYPE="Teradata" DBDNAME="dw" NAME="DW_CUSTOMER_DIM" OWNERNAME="DW"/>
      <TARGET NAME="STG_CUSTOMER_DEDUP"/>
      <TARGET NAME="MART_CUSTOMER"/>
      <MAPplet NAME="mp_dedup">
        <TRANSFORMATION NAME="in_dedup" TRANSFORMATION_TYPE="Input Transformation"/>
        <TRANSFORMATION NAME="rank_rows" TRANSFORMATION_TYPE="Rank">
          <TRANSFORMFIELD NAME="rnk" EXPRESSION="ORDER_DATE"/>
        </TRANSFORMATION>
        <TRANSFORMATION NAME="out_dedup" TRANSFORMATION_TYPE="Output Transformation"/>
      </MAPplet>
      <MAPPING NAME="m_customer_load">
        <INSTANCE NAME="src_cust" TYPE="SOURCE" TRANSFORMATION_NAME="ODS_CUSTOMERS"/>
        <INSTANCE NAME="sq_cust" TRANSFORMATION_TYPE="Source Qualifier" TRANSFORMATION_NAME="SQ_ODS_CUSTOMERS">
          <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT CUST_ID, FULL_NAME, SEGMENT_CODE FROM ODS.CUSTOMERS WHERE SEGMENT_CODE IS NOT NULL"/>
          <TABLEATTRIBUTE NAME="Source Filter" VALUE="SEGMENT_CODE &lt;&gt; 'TEST'"/>
        </INSTANCE>
        <TRANSFORMATION NAME="exp_names" TRANSFORMATION_TYPE="Expression">
          <TRANSFORMFIELD NAME="first_name" EXPRESSION="IIF(INSTR(FULL_NAME,' ')&gt;0, SUBSTR(FULL_NAME,1,INSTR(FULL_NAME,' ')-1), FULL_NAME)"/>
          <TRANSFORMFIELD NAME="seg_desc" EXPRESSION="DECODE(SEGMENT_CODE,'G','GOLD','S','SILVER','OTHER')"/>
          <TRANSFORMFIELD NAME="seg_rank" EXPRESSION=":LKP.lkp_segments(SEGMENT_CODE)"/>
        </TRANSFORMATION>
        <INSTANCE NAME="lkp_seg" REUSABLE="YES" TRANSFORMATION_TYPE="Lookup Procedure" TRANSFORMATION_NAME="lkp_segments"/>
        <INSTANCE NAME="tgt" TYPE="TARGET" TRANSFORMATION_NAME="MART_CUSTOMER"/>
        <CONNECTOR FROMINSTANCE="src_cust" FROMFIELD="CUST_ID" TOINSTANCE="exp_names" TOFIELD="CUST_ID"/>
        <CONNECTOR FROMINSTANCE="exp_names" FROMFIELD="first_name" TOINSTANCE="tgt" TOFIELD="FIRST_NAME"/>
        <MAPPINGVARIABLE NAME="$$BatchId" DATATYPE="integer"/>
      </MAPPING>
      <MAPPING NAME="m_customer_dedup">
        <INSTANCE NAME="src_stg" TYPE="SOURCE" TRANSFORMATION_NAME="STG_CUSTOMER_DEDUP"/>
        <INSTANCE NAME="mp_inst" TRANSFORMATION_TYPE="Mapplet" TRANSFORMATION_NAME="mp_dedup"/>
        <INSTANCE NAME="tgt_mart" TYPE="TARGET" TRANSFORMATION_NAME="MART_CUSTOMER"/>
      </MAPPING>
      <TRANSFORMATION NAME="lkp_segments" REUSABLE="YES" TRANSFORMATION_TYPE="Lookup Procedure">
        <TABLEATTRIBUTE NAME="Lookup table name" VALUE="ref.SEGMENTS"/>
        <TABLEATTRIBUTE NAME="Lookup Sql Override" VALUE="SELECT SEGMENT_CODE, SEGMENT_DESC FROM ref.SEGMENTS"/>
      </TRANSFORMATION>
      <TRANSFORMATION NAME="sp_audit" REUSABLE="YES" TRANSFORMATION_TYPE="Stored Procedure">
        <TABLEATTRIBUTE NAME="Stored Procedure Name" VALUE="etl.CUSTOMER_AUDIT"/>
      </TRANSFORMATION>
      <SESSION NAME="s_customer_load" MAPPINGNAME="m_customer_load">
        <ATTRIBUTE NAME="Pre-session command" VALUE="sh scripts/precheck_customers.sh"/>
        <SESSTRANSFORMATIONINST TRANSFORMATION_NAME="sq_cust">
          <ATTRIBUTE NAME="Sql Query" VALUE="SELECT CUST_ID, FULL_NAME, SEGMENT_CODE FROM ODS.CUSTOMERS WHERE ROWNUM &lt;= 100000"/>
        </SESSTRANSFORMATIONINST>
        <SESSTRANSFORMATIONINST TRANSFORMATION_NAME="tgt">
          <ATTRIBUTE NAME="Pre SQL" VALUE="TRUNCATE TABLE MART.CUSTOMER"/>
          <ATTRIBUTE NAME="Post SQL" VALUE="CALL etl.refresh_stats('CUSTOMER')"/>
        </SESSTRANSFORMATIONINST>
      </SESSION>
      <SESSION NAME="s_customer_dedup" MAPPINGNAME="m_customer_dedup" REUSABLE="YES"/>
      <SCHEDULER NAME="sch_daily" REUSABLE="YES"/>
    </FOLDER>
  </REPOSITORY>
</POWERMART>
