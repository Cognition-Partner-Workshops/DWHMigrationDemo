<?xml version="1.0" encoding="UTF-8"?>
<POWERMART>
  <REPOSITORY NAME="ODS_REPO">
    <FOLDER NAME="RETAIL_PRODUCT" OWNER="etlteam" SHARED="NOTSHARED">
      <SOURCE DATABASETYPE="Oracle" DBDNAME="ods" NAME="ODS_PRODUCTS" OWNERNAME="ODS"/>
      <SOURCE DATABASETYPE="DB2" DBDNAME="inv" NAME="INV_STOCK" OWNERNAME="INV"/>
      <TARGET NAME="MART_PRODUCT"/>
      <TARGET NAME="MART_STOCK_SNAPSHOT"/>
      <MAPPING NAME="m_product_load">
        <INSTANCE NAME="src_prod" TYPE="SOURCE" TRANSFORMATION_NAME="ODS_PRODUCTS"/>
        <TRANSFORMATION NAME="sq_prod" TRANSFORMATION_TYPE="Source Qualifier">
          <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT SKU, TITLE, CATEGORY_CODE FROM ODS.PRODUCTS WHERE ACTIVE_FLAG='Y'"/>
          <TABLEATTRIBUTE NAME="User Defined Join" VALUE="PRODUCTS P JOIN CATEGORIES C ON P.CATEGORY_CODE = C.CODE"/>
        </TRANSFORMATION>
        <TRANSFORMATION NAME="fil_active" TRANSFORMATION_TYPE="Filter"/>
        <TRANSFORMATION NAME="seqgen" TRANSFORMATION_TYPE="Sequence Generator"/>
        <INSTANCE NAME="tgt_prod" TYPE="TARGET" TRANSFORMATION_NAME="MART_PRODUCT"/>
      </MAPPING>
      <MAPPING NAME="m_stock_snapshot">
        <INSTANCE NAME="src_inv" TYPE="SOURCE" TRANSFORMATION_NAME="INV_STOCK"/>
        <TRANSFORMATION NAME="exp_avail" TRANSFORMATION_TYPE="Expression">
          <TRANSFORMFIELD NAME="avail" EXPRESSION="NVL(ON_HAND,0) - NVL(RESERVED,0)"/>
          <TRANSFORMFIELD NAME="reorder" EXPRESSION="IIF(ON_HAND &lt; REORDER_POINT, 'Y', 'N')"/>
        </TRANSFORMATION>
        <TRANSFORMATION NAME="lkp_loc" TRANSFORMATION_TYPE="Lookup Procedure">
          <TABLEATTRIBUTE NAME="Lookup table name" VALUE="ref.STORE_LOCATIONS"/>
          <TABLEATTRIBUTE NAME="Lookup Sql Override" VALUE="SELECT LOC_ID, LOC_NAME FROM ref.STORE_LOCATIONS WHERE OPEN_FLAG='Y'"/>
        </TRANSFORMATION>
        <INSTANCE NAME="tgt_stock" TYPE="TARGET" TRANSFORMATION_NAME="MART_STOCK_SNAPSHOT"/>
      </MAPPING>
      <MAPPING NAME="m_product_archive">
        <INSTANCE NAME="src_arch" TYPE="SOURCE" TRANSFORMATION_NAME="ODS_PRODUCTS"/>
        <TRANSFORMATION NAME="srt_sku" TRANSFORMATION_TYPE="Sorter"/>
        <INSTANCE NAME="tgt_arch" TYPE="TARGET" TRANSFORMATION_NAME="MART_PRODUCT"/>
      </MAPPING>
      <MAPPLET NAME="mp_category_split">
        <TRANSFORMATION NAME="in_cat" TRANSFORMATION_TYPE="Input Transformation"/>
        <TRANSFORMATION NAME="rt_cat" TRANSFORMATION_TYPE="Router"/>
        <TRANSFORMATION NAME="out_cat" TRANSFORMATION_TYPE="Output Transformation"/>
      </MAPPLET>
      <SESSION NAME="s_product_load" MAPPINGNAME="m_product_load">
        <SESSTRANSFORMATIONINST TRANSFORMATION_NAME="sq_prod">
          <ATTRIBUTE NAME="Post SQL" VALUE="CALL etl.audit_count('PRODUCT')"/>
        </SESSTRANSFORMATIONINST>
      </SESSION>
      <SESSION NAME="s_stock_snapshot" MAPPINGNAME="m_stock_snapshot"/>
      <SESSION NAME="s_product_archive" MAPPINGNAME="m_product_archive"/>
      <TRANSFORMATION NAME="lkp_categories" REUSABLE="YES" TRANSFORMATION_TYPE="Lookup Procedure">
        <TABLEATTRIBUTE NAME="Lookup table name" VALUE="ref.CATEGORIES"/>
      </TRANSFORMATION>
    </FOLDER>
  </REPOSITORY>
</POWERMART>
