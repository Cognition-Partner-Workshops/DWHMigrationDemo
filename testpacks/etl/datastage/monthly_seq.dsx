BEGIN DSJOB
   Identifier "monthly_seq"
   OLEType "CJobDefn"
   JobType "2"
   Name "monthly_seq"
   BEGIN DSRECORD
      Identifier "V0S1"
      OLEType "CJSJobActivity"
      Name "mth_orders"
      Jobname "dw_orders_load"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2"
      OLEType "CJSJobActivity"
      Name "mth_customers"
      Jobname "px_customers"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3"
      OLEType "CJSJobActivity"
      Name "mth_payments"
      Jobname "server_payments"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S4"
      OLEType "CJSJobActivity"
      Name "mth_products"
      Jobname "dsexport_products"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S5"
      OLEType "CJSJobActivity"
      Name "mth_agg"
      Jobname "dsx_products_agg"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S6"
      OLEType "CJSJobActivity"
      Name "mth_inv"
      Jobname "dsx_inventory_snap"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S7"
      OLEType "CJSJobActivity"
      Name "mth_recover"
      Jobname "recovered_job"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S8"
      OLEType "CJSExecCmdActivity"
      Name "send_report"
      CommandName "sh"
      Parameters "scripts/monthly_report.sh"
   END DSRECORD
END DSJOB
